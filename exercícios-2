#include <stdio.h>
#include <stdlib.h>

#define MAX 5 // Capacidade máxima de 5 bandejas na pilha da lanchonete

typedef struct {
    int bandejas[MAX]; // Vetor que armazena os números de identificação das bandejas
    int topo;          // Índice da bandeja no topo (-1 indica que não há bandejas)
} PilhaBandejas;

void inicializar(PilhaBandejas *p) {
    p->topo = -1;
}

int estaVazia(const PilhaBandejas *p) {
    return (p->topo == -1);
}

int estaCheia(const PilhaBandejas *p) {
    return (p->topo == MAX - 1);
}
