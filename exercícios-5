    return 1;
}

int desempilhar(PilhaHistorico *p, int *valorRecuperado) {
    if (estaVazia(p)) {
        return 0;
    }
    *valorRecuperado = p->itens[p->topo]; // Recupera o estado anterior
    p->topo--;                            // Decrementa o topo (remoção lógica)
    return 1;
}

void alterarValor(PilhaHistorico *p, int *valorAtual, int novoValor) {
    if (!empilhar(p, *valorAtual)) {
        printf("\n[Erro] Historico cheio (capacidade maxima de %d)! Alteracao rejeitada.\n", MAX);
        printf("O valor atual (%d) e o historico foram preservados.\n", *valorAtual);
        return;
    }
    *valorAtual = novoValor; // Substitui pelo novo valor somente após salvar o anterior
    printf("\nValor alterado com sucesso para: %d\n", *valorAtual);
}

void desfazerAlteracao(PilhaHistorico *p, int *valorAtual) {
    int valorAnterior;
    if (!desempilhar(p, &valorAnterior)) {
        printf("\n[Aviso] Nao ha historico disponivel. Nao e possivel desfazer.\n");
        return;
    }
    *valorAtual = valorAnterior; // Restaura o valor recuperado da pilha
    printf("\nOperacao desfeita! Valor atual restaurado para: %d\n", *valorAtual);
}
    printf("\n--- Estado Atual ---\n");
    printf("Valor atual: %d\n", valorAtual);

    if (estaVazia(p)) {
        printf("Historico disponivel: Vazio\n");
    } else {
        printf("Historico disponivel (mais recente -> mais antigo): ");
        for (int i = p->topo; i >= 0; i--) {
            printf("%d", p->itens[i]);
            if (i > 0) {
                printf(" -> ");
            }
        }
        printf("\n");
    }
    printf("--------------------\n");
}

