#include <stdio.h>
#include <stdlib.h>

#define MAX 5 // Capacidade máxima de estados anteriores armazenados no histórico

typedef struct {
    int itens[MAX]; // Vetor que armazena os valores anteriores
    int topo;       // Índice do elemento no topo (-1 indica histórico vazio)
} PilhaHistorico;

void inicializar(PilhaHistorico *p) {
    p->topo = -1;
}

int estaVazia(const PilhaHistorico *p) {
    return (p->topo == -1);
}

int estaCheia(const PilhaHistorico *p) {
    return (p->topo == MAX - 1);
}

